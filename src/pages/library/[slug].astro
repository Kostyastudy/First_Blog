---
import { render } from "astro:content";
import { existsSync } from "node:fs";
import path from "node:path";
import { ArrowLeft, Download, ExternalLink } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatBytes, formatDate, getSortedDocs, pdfSrc } from "../../utils/posts";

export async function getStaticPaths() {
  const docs = await getSortedDocs();
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc }
  }));
}

const { doc } = Astro.props;
const publicPath = path.join(process.cwd(), "public", doc.data.file.replace(/^\//, ""));

if (!existsSync(publicPath)) {
  throw new Error(`File is missing: public${doc.data.file} (referenced by library/${doc.id})`);
}

const { Content } = await render(doc);
const fileUrl = pdfSrc(doc.data.file);
const isPdf = doc.data.file.toLowerCase().endsWith(".pdf");
const previewPath = doc.data.preview || (isPdf ? doc.data.file : null);
if (previewPath) {
  const previewFile = path.join(process.cwd(), "public", previewPath.replace(/^\//, ""));
  if (!existsSync(previewFile)) {
    throw new Error(`Preview is missing: public${previewPath} (referenced by library/${doc.id})`);
  }
}
const previewUrl = previewPath ? pdfSrc(previewPath) : null;
const hasBody = Boolean((doc as typeof doc & { body?: string }).body?.trim());
---

<BaseLayout title={`${doc.data.title} · 资料库`} description={doc.data.description || "资料"}>
  <section class="simple-hero simple-hero--compact shell">
    <a class="article-header__back" href="/library">
      <ArrowLeft size={16} stroke-width={1.8} aria-hidden="true" />
      返回资料库
    </a>
    <p class="eyebrow">资料 · {doc.data.category}</p>
    <h1>{doc.data.title}</h1>
    {doc.data.description && <p>{doc.data.description}</p>}
    <p class="doc-detail__meta">
      {formatDate(doc.data.pubDate)} · {formatBytes(doc.data.bytes)}
      {doc.data.tags.length > 0 && ` · ${doc.data.tags.join(" / ")}`}
    </p>
    <div class="doc-actions">
      <a class="button button--primary" href={fileUrl} download>
        <Download size={16} stroke-width={1.8} aria-hidden="true" />
        {previewUrl && !isPdf ? "下载原文件" : "下载文件"}
      </a>
      {previewUrl && (
        <a class="text-link" href={previewUrl} target="_blank" rel="noreferrer">
          <ExternalLink size={16} stroke-width={1.8} aria-hidden="true" />
          新窗口打开 PDF
        </a>
      )}
    </div>
  </section>

  <section class="shell simple-section">
    {hasBody && <div class="prose doc-note"><Content /></div>}

    {
      previewUrl ? (
        <>
          <div class="pdf-frame">
            <iframe
              data-pdf-frame
              data-base={previewUrl}
              src={`${previewUrl}#view=FitH`}
              title={`${doc.data.title} PDF`}
              loading="lazy"
            />
          </div>
          <p class="pdf-hint">
            如果内嵌阅读器没有显示，请点上面的“新窗口打开 PDF”，或下载原文件。
          </p>
        </>
      ) : (
        <div class="file-card">
          <p>这是一份 Word/PPT 文件，暂时没有生成在线预览。</p>
          <p>请点击上方“下载原文件”保存到本地后用 Office 打开。</p>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  const frame = document.querySelector<HTMLIFrameElement>("[data-pdf-frame]");

  if (frame) {
    const base = frame.dataset.base ?? "";

    const applyHash = () => {
      const match = window.location.hash.match(/page=(\d+)/);
      frame.src = match ? `${base}#page=${match[1]}&view=FitH` : `${base}#view=FitH`;
    };

    applyHash();
    window.addEventListener("hashchange", applyHash);
  }
</script>
