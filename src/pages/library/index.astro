---
import { BookOpen, FileText, Folder } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSortedDocs, getSortedPosts } from "../../utils/posts";
import { buildContentItems } from "../../utils/library-items";
import {
  collectFolders,
  directChildren,
  folderHref,
  folderName,
  isInside,
  readFolderList
} from "../../utils/folders";

const posts = await getSortedPosts();
const docs = await getSortedDocs();
const items = buildContentItems(posts, docs);
const explicit = readFolderList();
const folders = collectFolders(explicit, items.map((item) => item.folder));

const roots = [
  ...new Set([
    ...readFolderList().filter((folder) => !folder.includes("/")),
    ...folders.filter((folder) => !folder.includes("/"))
  ])
];
const cards = roots.map((folder) => ({
  path: folder,
  name: folderName(folder),
  total: items.filter((item) => isInside(item.folder, folder)).length,
  notes: items.filter((item) => isInside(item.folder, folder) && item.kind === "note").length,
  materials: items.filter((item) => isInside(item.folder, folder) && item.kind === "material").length,
  subs: directChildren(folders, folder).length
}));
---

<BaseLayout title="资料库" description="按文件夹归档的笔记与资料。">
  <section class="simple-hero shell">
    <p class="eyebrow">Library</p>
    <h1>资料库</h1>
    <p>先选一个文件夹，再分别查看笔记和资料。共 {items.length} 项。</p>
  </section>

  <section class="shell simple-section">
    <div class="folder-grid">
      {
        cards.map((card) => (
          <a class="folder-card" href={folderHref(card.path)}>
            <Folder size={20} stroke-width={1.6} aria-hidden="true" />
            <strong>{card.name}</strong>
            <span>{card.total} 项 · {card.subs} 个子文件夹</span>
            <span class="folder-card__split">
              <em><BookOpen size={13} stroke-width={1.6} aria-hidden="true" />{card.notes} 笔记</em>
              <em><FileText size={13} stroke-width={1.6} aria-hidden="true" />{card.materials} 资料</em>
            </span>
          </a>
        ))
      }
    </div>

    {cards.length === 0 && <p class="empty-state">还没有文件夹。</p>}
  </section>
</BaseLayout>
