---
import { FileText } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatBytes, formatDate, getSortedDocs } from "../../utils/posts";

const docs = await getSortedDocs();
const tagCounts = docs.reduce<Record<string, number>>((result, doc) => {
  doc.data.tags.forEach((tag) => {
    result[tag] = (result[tag] || 0) + 1;
  });
  return result;
}, {});
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="资料库" description="课程 PDF、讲义和整理好的学习资料。">
  <section class="simple-hero shell">
    <p class="eyebrow">资料库</p>
    <h1>资料库</h1>
    <p>这里收录可以公开的课程资料。点击条目在线阅读，或直接下载。</p>
  </section>

  <section class="shell simple-section">
    {
      tags.length > 0 && (
        <div class="filter-row" role="group" aria-label="按标签筛选资料">
          <button class="filter-chip is-active" type="button" data-doc-filter="all">全部</button>
          {tags.map(([tag, count]) => (
            <button class="filter-chip" type="button" data-doc-filter={tag}>
              {tag}
              <span>{count}</span>
            </button>
          ))}
        </div>
      )
    }

    <p class="result-count" data-doc-count>共 {docs.length} 份资料</p>

    <ul class="doc-list">
      {
        docs.map((doc) => (
          <li class="doc-row" data-doc data-tags={doc.data.tags.join("|")}>
            <FileText size={20} stroke-width={1.6} aria-hidden="true" />
            <div class="doc-row__body">
              <a class="doc-row__title" href={`/library/${doc.id}`}>
                {doc.data.title}
              </a>
              <p class="doc-row__meta">
                {formatDate(doc.data.pubDate)} · {formatBytes(doc.data.bytes)}
                {doc.data.tags.length > 0 && ` · ${doc.data.tags.join(" / ")}`}
              </p>
              {doc.data.description && <p class="doc-row__description">{doc.data.description}</p>}
            </div>
          </li>
        ))
      }
    </ul>

    <p class="empty-state" data-doc-empty hidden={docs.length > 0}>
      还没有资料。把 PDF 放进 <code>public/files/</code>，在 <code>src/content/library/</code> 建一个条目，或运行 <code>npm run import</code>。
    </p>
  </section>
</BaseLayout>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-doc]"));
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-doc-filter]"));
  const count = document.querySelector<HTMLElement>("[data-doc-count]");
  const empty = document.querySelector<HTMLElement>("[data-doc-empty]");

  const applyFilter = (tag: string) => {
    let visible = 0;

    rows.forEach((row) => {
      const matches = tag === "all" || (row.dataset.tags ?? "").split("|").includes(tag);
      row.hidden = !matches;
      if (matches) visible += 1;
    });

    if (count) count.textContent = tag === "all" ? `共 ${visible} 份资料` : `“${tag}” 下共 ${visible} 份资料`;
    if (empty) empty.hidden = visible !== 0;
  };

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      buttons.forEach((item) => item.classList.toggle("is-active", item === button));
      applyFilter(button.dataset.docFilter ?? "all");
    });
  });
</script>
