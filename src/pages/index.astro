---
import { readFileSync } from "node:fs";
import path from "node:path";
import { Search } from "@lucide/astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
import { getSortedPosts } from "../utils/posts";

const folders = JSON.parse(
  readFileSync(path.join(process.cwd(), "src", "data", "folders.json"), "utf8")
) as string[];
const posts = await getSortedPosts();
const noteFolder = (category: string, folder?: string) => {
  if (folder) return folder;
  if (["微积分Ⅰ", "导航", "复习"].includes(category)) return "微积分Ⅰ";
  if (category === "线性代数") return "线性代数";
  return "其他";
};
const folderCounts = folders
  .map((name) => ({
    name,
    count: posts.filter((post) => noteFolder(post.data.category, post.data.folder) === name).length
  }))
  .filter((folder) => folder.count > 0);
const hasPosts = posts.length > 0;
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="eyebrow">Notes · {siteConfig.startYear}</p>
      <h1>
        {siteConfig.heroTitle}
        <span>{siteConfig.heroSubtitle}</span>
      </h1>
      <p class="hero__lead">{siteConfig.description}</p>
      <div class="hero__actions">
        <a class="button button--primary" href="#notes">浏览笔记</a>
        <a class="text-link" href="/library">资料库</a>
        <a class="text-link" href="/about">关于</a>
      </div>
    </div>

    <aside class="hero__intro">
      <p class="eyebrow">About</p>
      <p class="hero__intro-text">{siteConfig.homeIntro}</p>
    </aside>
  </section>

  <section class="notes-section shell" id="notes">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Archive</p>
        <h2>全部笔记</h2>
      </div>
      <p>
        共 {posts.length} 篇，按发布时间倒序。搜索标题或摘要，需要搜正文时用
        <a class="text-link" href="/search">全文搜索</a>。
      </p>
    </div>

    {
      hasPosts ? (
        <>
          <div class="note-controls">
            <label class="search-box" for="note-search">
              <Search size={18} stroke-width={1.8} aria-hidden="true" />
              <span class="sr-only">搜索笔记</span>
              <input
                id="note-search"
                type="search"
                placeholder="搜索标题、摘要或关键词"
                autocomplete="off"
                data-search-input
              />
            </label>

            <div class="filter-row" role="group" aria-label="按文件夹筛选">
              <button class="filter-chip is-active" type="button" data-filter-folder="all">全部</button>
              {folderCounts.map((folder) => (
                <button class="filter-chip" type="button" data-filter-folder={folder.name}>
                  {folder.name}
                  <span>{folder.count}</span>
                </button>
              ))}
            </div>
          </div>

          <p class="result-count" data-result-count aria-live="polite">显示 {posts.length} 篇笔记</p>

          <div class="timeline">
            {posts.map((post, index) => (
              <PostCard post={post} index={index} />
            ))}
          </div>

          <p class="empty-state" data-empty-state hidden>
            没有找到匹配的笔记。换一个关键词，或选择“全部”。
          </p>
        </>
      ) : (
        <div class="empty-blog">
          <p>还没有发布文章。</p>
          <p>
            把 Markdown 放进 <code>inbox/</code> 后运行 <code>npm run import</code>，或直接在
            <code>src/content/posts/</code> 新建 <code>.md</code> 文件。
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  const postItems = Array.from(document.querySelectorAll<HTMLElement>("[data-post]"));
  const searchInput = document.querySelector<HTMLInputElement>("[data-search-input]");
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-filter-folder]")
  );
  const resultCount = document.querySelector<HTMLElement>("[data-result-count]");
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");
  let activeFolder = "all";

  const normalize = (value: string) => value.trim().toLowerCase();

  const updateResults = () => {
    const query = normalize(searchInput?.value ?? "");
    let visibleCount = 0;

    postItems.forEach((post) => {
      const folder = post.dataset.folder ?? "";
      const searchable = post.dataset.search ?? "";
      const matchesFolder = activeFolder === "all" || folder === activeFolder;
      const matchesQuery = !query || searchable.includes(query);
      const isVisible = matchesFolder && matchesQuery;

      post.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });

    if (resultCount) resultCount.textContent = `显示 ${visibleCount} 篇笔记`;
    if (emptyState) emptyState.hidden = visibleCount !== 0;
  };

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeFolder = button.dataset.filterFolder ?? "all";
      filterButtons.forEach((item) => item.classList.toggle("is-active", item === button));
      updateResults();
    });
  });

  searchInput?.addEventListener("input", updateResults);
  searchInput?.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      event.preventDefault();
      const query = searchInput.value.trim();
      window.location.href = query ? `/search?q=${encodeURIComponent(query)}` : "/search";
    }
  });
</script>
