---
import { readFileSync } from "node:fs";
import path from "node:path";
import { Search } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
import { formatBytes, formatDate, getSortedDocs, getSortedPosts } from "../utils/posts";
import { buildContentItems } from "../utils/library-items";
import { collectFolders, folderName, isInside, parentOf } from "../utils/folders";

const folders = JSON.parse(
  readFileSync(path.join(process.cwd(), "src", "data", "folders.json"), "utf8")
) as string[];

const posts = await getSortedPosts();
const docs = await getSortedDocs();
const items = buildContentItems(posts, docs);
const allFolders = collectFolders(folders, items.map((item) => item.folder));

const topFolders = [
  ...folders.filter((folder) => !folder.includes("/")),
  ...allFolders.filter((folder) => !folder.includes("/") && !folders.includes(folder))
];
const folderCounts = topFolders
  .map((name) => ({
    name,
    count: items.filter((item) => isInside(item.folder, name)).length
  }))
  .filter((folder) => folder.count > 0);
const subfolderGroups = folderCounts.map((folder) => ({
  ...folder,
  children: allFolders
    .filter((path) => parentOf(path) === folder.name)
    .map((path) => ({
      path,
      name: folderName(path),
      count: items.filter((item) => isInside(item.folder, path)).length
    }))
}));

const hasItems = items.length > 0;
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="eyebrow">Notes · {siteConfig.startYear}</p>
      <h1>
        {siteConfig.heroTitle}
        <span>{siteConfig.heroSubtitle}</span>
      </h1>
      <p class="hero__lead">{siteConfig.description}</p>
      <div class="hero__actions">
        <a class="button button--primary" href="#notes">浏览内容</a>
        <a class="text-link" href="/library">资料库</a>
        <a class="text-link" href="/about">关于</a>
      </div>
    </div>

    <aside class="hero__intro">
      <p class="eyebrow">About</p>
      <p class="hero__intro-text">{siteConfig.homeIntro}</p>
    </aside>
  </section>

  <section class="notes-section shell" id="notes">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Archive</p>
        <h2>全部内容</h2>
      </div>
      <p>
        共 {items.length} 项，按最近编辑时间倒序。搜索标题或摘要，需要搜正文时用
        <a class="text-link" href="/search">全文搜索</a>。
      </p>
    </div>

    {
      hasItems ? (
        <>
          <div class="note-controls">
            <label class="search-box" for="note-search">
              <Search size={18} stroke-width={1.8} aria-hidden="true" />
              <span class="sr-only">搜索内容</span>
              <input
                id="note-search"
                type="search"
                placeholder="搜索标题、摘要或文件夹"
                autocomplete="off"
                data-search-input
              />
            </label>

            <div class="filter-row" role="group" aria-label="按文件夹筛选">
              <button class="filter-chip is-active" type="button" data-filter-folder="all">全部</button>
              {folderCounts.map((folder) => (
                <button class="filter-chip" type="button" data-filter-folder={folder.name}>
                  {folder.name}
                  <span>{folder.count}</span>
                </button>
              ))}
            </div>

            {subfolderGroups
              .filter((group) => group.children.length > 0)
              .map((group) => (
                <div class="subfolder-row" data-subrow={group.name} hidden>
                  <div class="filter-row" role="group" aria-label={`${group.name}的子文件夹`}>
                    <button
                      class="filter-chip is-active"
                      type="button"
                      data-subfolder="all"
                      data-subparent={group.name}
                    >
                      全部
                    </button>
                    {group.children.map((child) => (
                      <button
                        class="filter-chip"
                        type="button"
                        data-subfolder={child.path}
                        data-subparent={group.name}
                      >
                        {child.name}
                        <span>{child.count}</span>
                      </button>
                    ))}
                  </div>
                </div>
              ))}
          </div>

          <p class="result-count" data-result-count aria-live="polite">显示 {items.length} 项</p>

          <div class="timeline">
            {items.map((item) => (
              <article
                class="timeline-post"
                data-item
                data-folder={item.folder}
                data-search={item.search}
              >
                <div class="timeline-post__rail" aria-hidden="true"></div>
                <div class="timeline-post__body">
                  <div class="post-meta">
                    <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
                    <span>{item.label}</span>
                    <span>{item.folder}</span>
                    {"bytes" in item && item.bytes ? <span>{formatBytes(item.bytes)}</span> : null}
                  </div>

                  <h3 class="timeline-post__title">
                    <a href={item.href}>{item.title}</a>
                  </h3>

                  <p class="timeline-post__description">{item.description}</p>
                </div>
              </article>
            ))}
          </div>

          <p class="empty-state" data-empty-state hidden>
            没有找到匹配的内容。换一个关键词，或选择“全部”。
          </p>
        </>
      ) : (
        <div class="empty-blog">
          <p>还没有发布内容。</p>
          <p>在写作台里新建笔记或上传文件，然后点「发布上线」。</p>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  const contentItems = Array.from(document.querySelectorAll<HTMLElement>("[data-item]"));
  const searchInput = document.querySelector<HTMLInputElement>("[data-search-input]");
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-filter-folder]")
  );
  const resultCount = document.querySelector<HTMLElement>("[data-result-count]");
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");
  const subRows = Array.from(document.querySelectorAll<HTMLElement>("[data-subrow]"));
  const subButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-subfolder]")
  );
  let activeFolder = "all";
  let activeSub = "all";

  const normalize = (value: string) => value.trim().toLowerCase();
  const isInside = (folder: string, parent: string) =>
    parent === "all" || folder === parent || folder.startsWith(`${parent}/`);

  const updateResults = () => {
    const query = normalize(searchInput?.value ?? "");
    let visibleCount = 0;

    contentItems.forEach((item) => {
      const folder = item.dataset.folder ?? "";
      const searchable = item.dataset.search ?? "";
      const matchesFolder = isInside(folder, activeSub === "all" ? activeFolder : activeSub);
      const matchesQuery = !query || searchable.includes(query);
      const isVisible = matchesFolder && matchesQuery;

      item.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });

    if (resultCount) resultCount.textContent = `显示 ${visibleCount} 项`;
    if (emptyState) emptyState.hidden = visibleCount !== 0;
  };

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeFolder = button.dataset.filterFolder ?? "all";
      activeSub = "all";
      filterButtons.forEach((item) => item.classList.toggle("is-active", item === button));

      subRows.forEach((row) => {
        const matches = row.dataset.subrow === activeFolder;
        row.hidden = !matches;
        if (matches) {
          row.querySelectorAll<HTMLButtonElement>("[data-subfolder]").forEach((item) => {
            item.classList.toggle("is-active", item.dataset.subfolder === "all");
          });
        }
      });

      updateResults();
    });
  });

  subButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeSub = button.dataset.subfolder ?? "all";
      const parent = button.dataset.subparent;
      subButtons
        .filter((item) => item.dataset.subparent === parent)
        .forEach((item) => item.classList.toggle("is-active", item === button));
      updateResults();
    });
  });

  searchInput?.addEventListener("input", updateResults);
  searchInput?.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      event.preventDefault();
      const query = searchInput.value.trim();
      window.location.href = query ? `/search?q=${encodeURIComponent(query)}` : "/search";
    }
  });
</script>
