---
import { render, getEntry } from "astro:content";
import { Mail, ArrowUpRight } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";

const entry = await getEntry("pages", "about");
if (!entry) throw new Error("Missing src/content/pages/about.md");

const { Content } = await render(entry);
---

<BaseLayout title={`关于 · ${siteConfig.name}`} description={entry.data.description || "关于这个站点"}>
  <section class="simple-hero simple-hero--compact shell">
    <p class="eyebrow">关于</p>
    <h1>{entry.data.title}</h1>
    {entry.data.description && <p>{entry.data.description}</p>}
  </section>

  <section class="shell simple-section about-content">
    <div class="prose">
      <Content />
    </div>

    {
      entry.data.links.length > 0 && (
        <div class="about-links">
          <p class="eyebrow">Links</p>
          {entry.data.links.map((link) => (
            <a class="about-link" href={link.url} target={link.url.startsWith("mailto:") ? undefined : "_blank"} rel="noreferrer">
              <Mail size={16} stroke-width={1.8} aria-hidden="true" />
              {link.label}
              <ArrowUpRight size={14} stroke-width={1.8} aria-hidden="true" />
            </a>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
